APP_NAME="Inbox Sentry"
API_TOKEN=
MONGODB_URI=
MONGODB_DATABASE=finalx_gmail_auto
MONGODB_FEEDBACK_COLLECTION=feedback
MONGODB_THREAT_CACHE_COLLECTION=threat_cache
MONGODB_THREAT_QUEUE_COLLECTION=threat_queue
MONGODB_LABELED_DATASET_COLLECTION=labeled_dataset

# OAuth 檔案預設可用 credentials.json；若根目錄有 client_secret_*.json，程式也會自動抓。
# CREDENTIALS_FILE="credentials.json"

# Gmail 搜尋條件。預設只看 Inbox 近 1 天的新信，避免第一次啟動掃描整個信箱。
GMAIL_QUERY="in:inbox newer_than:1d -in:drafts"
GMAIL_BATCH_SIZE=20
GMAIL_SCAN_PAGES=5
GMAIL_POLL_SECONDS=15
GMAIL_HISTORY_MAX_RESULTS=100
GMAIL_HISTORY_MAX_PAGES=10
GMAIL_WATCH_TOPIC_NAME=
GMAIL_WATCH_LABEL_IDS=INBOX
GMAIL_WATCH_LABEL_FILTER_BEHAVIOR=INCLUDE
GMAIL_AUTO_REGISTER_WATCH=false
GMAIL_PUSH_TOKEN=

# 60 以上會被視為高風險，worker 會自動加 Gmail 標籤。
HIGH_RISK_THRESHOLD=60
MEDIUM_RISK_THRESHOLD=30
GMAIL_HIGH_RISK_LABEL="Inbox Sentry 高風險"
GMAIL_WARNING_LABEL="Inbox Sentry 中風險"
GMAIL_REASON_LABEL_PREFIX="Inbox Sentry 理由"
LABEL_MEDIUM_RISK=true
ENABLE_REASON_LABELS=true
MARK_STARRED=false
MARK_IMPORTANT=false

# Push 模式下不需要輪詢。只有要 fallback 輪詢時才打開。
ENABLE_BACKGROUND_WORKER=false

# true 時也會保存低風險 skip 紀錄；預設只保存高風險與錯誤。
SAVE_SAFE_EVENTS=false

# Optional external threat intelligence. Sources without keys are skipped.
ENABLE_EXTERNAL_THREAT_LOOKUPS=true
ENABLE_URLHAUS_LOOKUP=true
ENABLE_THREAT_INTEL_CACHE=true
THREAT_INTEL_CACHE_TTL_HOURS=168
THREAT_INTEL_CACHE_MAX_ENTRIES=2000
THREAT_INTEL_QUEUE_MAX_ENTRIES=1000
THREAT_LOOKUP_FORCE_IPV4=true
EXTERNAL_LOOKUP_TIMEOUT_SECONDS=12
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
SERPAPI_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=

# Gemini LLM 意圖判斷，預設關閉；若要使用，填 GEMINI_API_KEY 並設 true。
GEMINI_API_KEY=
GEMINI_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_TIMEOUT_SECONDS=15
ENABLE_LLM_INTENT_CLASSIFIER=false
GEMINI_INTENT_MODEL=gemini-2.5-flash
LLM_INTENT_MIN_SCORE=30
LLM_INTENT_MAX_SCORE=75
LLM_INTENT_MAX_TEXT_CHARS=2500

# SetFit 多語郵件分類。模型存在時由它主判語意；模型缺失/失敗時才退回規則。
ENABLE_SETFIT_CLASSIFIER=true
SETFIT_MODEL_DIR=data/models/setfit-email-risk
SETFIT_BASE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SETFIT_DEVICE=cpu
SETFIT_MAX_TEXT_CHARS=3500
SETFIT_TRAINING_EPOCHS=1
SETFIT_TRAINING_ITERATIONS=2
SETFIT_THREAT_PROBABILITY=0.52
SETFIT_THREAT_HIGH_PROBABILITY=0.72
SETFIT_THREAT_CRITICAL_PROBABILITY=0.85
SETFIT_SUSPICIOUS_PROBABILITY=0.60
SETFIT_LEGITIMATE_PROBABILITY=0.65
SETFIT_LEGITIMATE_HIGH_PROBABILITY=0.80
SETFIT_OOD_MIN_SIMILARITY=0.35

# Dashboard 與 Discord webhook。DISCORD_WEBHOOK_URL 留空時不會發送通知。
DASHBOARD_RECENT_EVENTS_LIMIT=25
FEEDBACK_AUTO_APPROVE=false
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_MIN_RISK_LEVEL=high
DISCORD_TIMEOUT_SECONDS=6
